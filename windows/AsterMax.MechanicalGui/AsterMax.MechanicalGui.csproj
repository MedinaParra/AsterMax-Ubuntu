<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AsterMax-Mechanical</AssemblyName>
    <RootNamespace>AsterMax.MechanicalGui</RootNamespace>
    <Version>0.8.1-beta</Version>
    <Authors>Exequiel Medina</Authors>
    <Company>AsterMax</Company>
    <Product>AsterMax Windows 2.0 beta — Mechanical</Product>
    <Description>Windows 10/11 x64 Mechanical environment with transactional OpenCASCADE STEP import, native FreeCAD Qt/Coin3D visualization, Gmsh tetrahedral meshing and evidence-based tutorial certification.</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="SimpleStaticModel.cs" />
    <Compile Remove="MeshConvergenceDomain.cs" />
    <Compile Remove="ProjectWorkflowDomain.cs" />
    <Compile Remove="ProjectWorkflowModel.cs" />
    <Compile Remove="WorkflowProjectState.cs" />
    <!-- Obsolete experimental UI layers. They used global timers/reflection and competed
         with the production TreeView/Details and CAD visualization. -->
    <Compile Remove="MechanicalForm.UiStateRepair.cs" />
    <Compile Remove="CadViewerQualityAndNavigation.cs" />
    <Compile Remove="MechanicalInterfaceRoadmapIteration.cs" />
    <EmbeddedResource Include="Icons\AsterMaxIconSet.svg" />
    <Content Include="FreeCAD\astermax_freecad_viewer.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>