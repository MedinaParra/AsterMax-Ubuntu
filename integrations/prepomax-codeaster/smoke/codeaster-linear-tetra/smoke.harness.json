{
  "schema": 1,
  "case_name": "real-codeaster-linear-tetra",
  "solver": "code_aster",
  "job_name": "smoke",
  "working_directory": ".",
  "solver_executable": "docker",
  "timeout_seconds": 600,
  "required_inputs": [
    "smoke.comm",
    "smoke.mail",
    "smoke.export"
  ],
  "required_outputs": [
    "smoke.mess",
    "smoke.rmed",
    "smoke.resu"
  ],
  "solver_command": [
    "docker",
    "run",
    "--rm",
    "-v",
    "${GITHUB_WORKSPACE}/integrations/prepomax-codeaster/smoke/codeaster-linear-tetra:/home/user/data",
    "-w",
    "/home/user/data",
    "simvia/code_aster:17.4.0",
    "bash",
    "-i",
    "-c",
    "run_aster smoke.export"
  ],
  "result_contract": {
    "required_tables": [
      "PPM_DEPL",
      "PPM_STRESS_N",
      "PPM_STRESS_S",
      "PPM_STRAIN_N",
      "PPM_STRAIN_S"
    ],
    "min_rows_per_table": 4
  }
}
