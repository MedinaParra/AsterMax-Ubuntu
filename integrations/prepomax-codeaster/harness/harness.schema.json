{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astermax.local/schemas/solver-harness-v1.json",
  "title": "AsterMax Solver Harness Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "solver", "job_name", "working_directory"],
  "properties": {
    "schema": {
      "const": 1
    },
    "case_name": {
      "type": "string",
      "minLength": 1
    },
    "solver": {
      "enum": ["code_aster", "calculix"]
    },
    "job_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "minLength": 1
    },
    "working_directory": {
      "type": "string",
      "minLength": 1
    },
    "solver_executable": {
      "type": "string",
      "minLength": 1
    },
    "solver_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "min_input_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "min_output_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "required_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    },
    "fatal_message_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_contract": {
      "oneOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "required_tables": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "min_rows_per_table": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
