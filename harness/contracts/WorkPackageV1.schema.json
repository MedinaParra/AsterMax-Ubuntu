{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astermax.local/harness/WorkPackageV1.schema.json",
  "title": "WorkPackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workpackage_id", "title", "objective", "issue", "allowed_files", "prohibited_actions", "acceptance_criteria", "required_gates", "numerical_impact", "human_merge_required"],
  "properties": {
    "schema_version": {"const": "WorkPackageV1"},
    "workpackage_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "issue": {"type": ["integer", "null"], "minimum": 1},
    "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "forbidden_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "max_files_changed": {"type": "integer", "minimum": 1},
    "prohibited_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "numerical_impact": {"type": "boolean"},
    "human_merge_required": {"type": "boolean"},
    "validity_risks": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evaluation_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_agent_turns": {"type": ["integer", "null"], "minimum": 1},
        "max_tool_calls": {"type": ["integer", "null"], "minimum": 1},
        "max_retries": {"type": ["integer", "null"], "minimum": 0},
        "max_wall_clock_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "max_cost_usd": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "metadata": {"type": "object"}
  }
}
