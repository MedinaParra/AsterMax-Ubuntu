{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astermax.local/harness/GateResultV1.schema.json",
  "title": "GateResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "status", "evidence_type", "summary"],
  "properties": {
    "schema_version": {"const": "GateResultV1"},
    "gate_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "ERROR", "SKIPPED"]},
    "evidence_type": {"enum": ["scope_check", "command", "benchmark", "review_artifact"]},
    "summary": {"type": "string", "minLength": 1},
    "command": {"type": ["array", "null"], "items": {"type": "string"}},
    "exit_code": {"type": ["integer", "null"]},
    "evidence": {"type": "object"}
  }
}
