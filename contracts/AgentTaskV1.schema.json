{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astermax.local/contracts/AgentTaskV1.schema.json",
  "title": "AgentTaskV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "agent_id",
    "objective",
    "allowed_inputs",
    "expected_output_contract",
    "acceptance_criteria",
    "prohibited_actions",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "AgentTaskV1"},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^A([0-9]|1[0-2])$"},
    "objective": {"type": "string", "minLength": 1},
    "allowed_inputs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "expected_output_contract": {"type": "string", "minLength": 1},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "prohibited_actions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "parent_task_id": {"type": ["string", "null"]},
    "human_approval_required": {"type": "boolean", "default": false},
    "timeout_seconds": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"}
  }
}
