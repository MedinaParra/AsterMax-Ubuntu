{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astermax.local/contracts/AgentResultV1.schema.json",
  "title": "AgentResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "project_id",
    "agent_id",
    "status",
    "output_contract",
    "evidence_class",
    "summary",
    "artifact_ids",
    "created_at",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "AgentResultV1"},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^A([0-9]|1[0-2])$"},
    "status": {"enum": ["SUCCESS", "FAILED", "BLOCKED"]},
    "output_contract": {"type": "string", "minLength": 1},
    "evidence_class": {
      "enum": [
        "USER_INPUT",
        "AGENT_PROPOSAL",
        "DETERMINISTIC_CALCULATION",
        "SOLVER_RESULT",
        "SURROGATE_PREDICTION"
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "artifact_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  }
}
